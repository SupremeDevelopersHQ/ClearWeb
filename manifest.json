{
    "manifest_version":  3,
    "name":  "ClearWeb: The Ultimate Web Toolkit",
    "version":  "6.1.0",
    "description":  "The ultimate web enhancement suite: unblock right-click, OCR image extraction, Dark Mode, Clipboard Vault, and true Reader Mode!",
    "permissions":  [
                        "storage",
                        "activeTab",
                        "scripting",
                        "downloads",
                        "tabs",
                        "contextMenus",
                        "clipboardWrite"
                    ],
    "host_permissions":  [
                             "\u003call_urls\u003e"
                         ],
    "background":  {
                       "service_worker":  "background.js"
                   },
    "content_scripts":  [
                            {
                                "matches":  [
                                                "\u003call_urls\u003e"
                                            ],
                                "js":  [
                                           "content.js"
                                       ],
                                "run_at":  "document_start",
                                "all_frames":  true
                            }
                        ],
    "action":  {
                   "default_popup":  "popup/popup.html",
                   "default_icon":  {
                                        "16":  "icons/icon16.png",
                                        "48":  "icons/icon48.png",
                                        "128":  "icons/icon128.png"
                                    }
               },
    "icons":  {
                  "16":  "icons/icon16.png",
                  "48":  "icons/icon48.png",
                  "128":  "icons/icon128.png"
              },
    "web_accessible_resources":  [
                                     {
                                         "resources":  [
                                                           "injected.js",
                                                           "unblock.css",
                                                           "worker.min.js",
                                                           "tesseract-core.wasm.js",
                                                           "eng.traineddata.gz",
                                                           "tesseract.min.js",
                                                           "Readability.js"
                                                       ],
                                         "matches":  [
                                                         "\u003call_urls\u003e"
                                                     ]
                                     }
                                 ]
}
